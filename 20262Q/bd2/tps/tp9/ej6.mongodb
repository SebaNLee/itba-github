// ejercicio en sí

// a.
print("a");
db.bands.find({$and: [{genre: "ROCK"}, {members: {$gt: 2}}]});

// b.
print("b");
db.bands.aggregate([
    {$match: {insc: {$lte: new Date("2017, 11, 27")}}},
    {$group: {
        _id: "$genre",
        promedio_integrantes: {$avg: "$members"},
        cant_bandas: {$sum: 1}
    }},
    {$sort: {promedio_integrantes: -1}},
    {$project: {
        _id: 0,
        genero: "$_id",
        promedio_integrantes: 1,
        cant_bandas: 1
    }}
]);
