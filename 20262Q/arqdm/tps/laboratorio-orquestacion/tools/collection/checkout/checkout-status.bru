meta {
  name: checkout-status
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/checkout/{{checkoutOrderId}}/status
  body: none
  auth: inherit
}

script:pre-request {
  const orderId = bru.getVar("checkoutOrderId");
  if (!orderId) {
    throw new Error("No orderId found. Please run the checkout request first to capture an orderId.");
  }
  console.log("Using orderId:", orderId);
}

script:post-response {
  if (res && res.body) {
    console.log("Checkout Status Response:");
    console.log("Status:", res.body.status);
    console.log("State:", res.body.state);
    console.log("Participants:");
    if (res.body.participants) {
      res.body.participants.forEach(p => {
        console.log(`  - ${p.service}: ${p.state} (vote: ${p.vote || 'pending'})`);
      });
    }
  }
}